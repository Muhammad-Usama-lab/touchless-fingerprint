<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@android:color/white"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:strokeColor="#E0E0E0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Images Container - Side by Side -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!-- Captured Image Container -->
            <FrameLayout
                android:id="@+id/capturedImageContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#F5F5F5">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Label -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#E3F2FD"
                        android:gravity="center"
                        android:paddingVertical="4dp"
                        android:text="Captured"
                        android:textColor="#1976D2"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Captured Image -->
                    <ImageView
                        android:id="@+id/capturedImage"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:contentDescription="Captured fingerprint"
                        android:scaleType="fitCenter"
                        tools:src="@drawable/fingerprint" />

                </LinearLayout>

                <!-- Loading indicator -->
                <ProgressBar
                    android:id="@+id/capturedLoadingProgress"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:visibility="gone" />

                <!-- Placeholder when no captured image -->
                <LinearLayout
                    android:id="@+id/capturedPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="No image"
                        android:src="@drawable/ic_error"
                        app:tint="#BDBDBD" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Not available"
                        android:textColor="#BDBDBD"
                        android:textSize="10sp" />

                </LinearLayout>

            </FrameLayout>

            <!-- Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="#E0E0E0" />

            <!-- Processed Image Container -->
            <FrameLayout
                android:id="@+id/processedImageContainer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="#F5F5F5">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Label -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#E8F5E9"
                        android:gravity="center"
                        android:paddingVertical="4dp"
                        android:text="Processed"
                        android:textColor="#388E3C"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Processed Image -->
                    <ImageView
                        android:id="@+id/processedImage"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:contentDescription="Processed fingerprint"
                        android:scaleType="fitCenter"
                        tools:src="@drawable/fingerprint" />

                </LinearLayout>

                <!-- Loading indicator -->
                <ProgressBar
                    android:id="@+id/processedLoadingProgress"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:visibility="gone" />

                <!-- Error indicator -->
                <LinearLayout
                    android:id="@+id/processedErrorContainer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="20dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:contentDescription="Error"
                        android:src="@drawable/ic_error"
                        app:tint="#9E9E9E" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Load failed"
                        android:textColor="#9E9E9E"
                        android:textSize="10sp" />

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

        <!-- Tap hint -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FAFAFA"
            android:gravity="center"
            android:paddingVertical="4dp"
            android:text="Tap image to view full screen"
            android:textColor="#9E9E9E"
            android:textSize="10sp" />

        <!-- Info and Buttons Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Finger Name -->
            <TextView
                android:id="@+id/fingerNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/mp_color_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Right Index" />

            <!-- File Name -->
            <TextView
                android:id="@+id/fileNameText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:textColor="#757575"
                android:textSize="12sp"
                tools:text="RIGHT_INDEX_processed.png" />

            <!-- Download Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <!-- Download PNG Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/downloadPngButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:text="PNG"
                    android:textColor="@color/mp_color_primary"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_download"
                    app:iconGravity="textStart"
                    app:iconTint="@color/mp_color_primary"
                    app:strokeColor="@color/mp_color_primary"
                    app:strokeWidth="1dp" />

                <!-- Download WSQ Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/downloadWsqButton"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="WSQ"
                    android:textColor="@color/mp_color_secondary"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_download"
                    app:iconGravity="textStart"
                    app:iconTint="@color/mp_color_secondary"
                    app:strokeColor="@color/mp_color_secondary"
                    app:strokeWidth="1dp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
