<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/fingerprint_image"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/fingerprint"
        android:contentDescription="@string/fingerprint_icon_content_description"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:id="@+id/company_name_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="#666666"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start Biometrics"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/start_biometrics_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start Biometrics"
        android:visibility="gone"/>

    <Button
        android:id="@+id/launch_sdk_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Launch SDK"/>

</LinearLayout>