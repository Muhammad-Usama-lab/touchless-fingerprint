<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="bsdk_AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar" >
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/bsdk_rmst_color_primary</item>
        <item name="colorPrimaryVariant">@color/bsdk_rmst_color_primary_dark</item>
        <item name="colorPrimaryDark">@color/bsdk_rmst_color_primary_dark</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/bsdk_rmst_color_accent</item>
        <item name="colorSecondaryVariant">@color/bsdk_rmst_color_accent</item>
        <item name="colorError">@color/bsdk_color_error</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="bsdk_AppThemeProgressStyle">
        <item name="colorAccent">@color/bsdk_rmst_color_accent</item>
    </style>

        <style name="bsdk_Theme.App.Starting" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>